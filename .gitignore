# Secrets — never commit
.env
api_data.env
*.env

# Local state / SQLite databases (server-side or local runtime)
*.db
*.db-wal
*.db-shm

# Local research outputs / runtime caches
falling_knife_results.csv
wedge_cache.json
fred_cache.json
bank_rates_cache.json
macro_state.json
volume_leaders_cache.json
reversion_cache.json
gainers_cache.json

# Python / OS junk
__pycache__/
*.pyc
.DS_Store

# local DB snapshots (off-VM backups, never in git)
_db_snapshots/

# Runtime logs — never in git (this rule exists because a launchd TCC-denial
# log fossil from Aug 5 2026 sat untracked in the repo root for four days)
*.log
